#!/bin/sh
#
# Full checks before code leaves the laptop: the build, then the same `composer ci:check` CI runs.
# Pushing tags or deleting branches skips the checks. Pushing to main or staging is refused:
# they change only through pull requests.

zero=0000000000000000000000000000000000000000
needs_checks=0

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main | refs/heads/staging)
            printf '\n\033[31mPush refused:\033[0m never push to %s. Push your branch and open a pull request into staging (docs/team/workflow.md).\n' "${remote_ref#refs/heads/}"
            exit 1
            ;;
    esac
    [ "$local_sha" = "$zero" ] && continue
    case "$local_ref" in refs/tags/*) continue ;; esac
    needs_checks=1
done

[ "$needs_checks" -eq 0 ] && exit 0

log=$(mktemp)
trap 'rm -f "$log"' EXIT

fail() {
    tail -n 80 "$log"
    printf '\n\033[31mPush refused:\033[0m %s\n' "$1"
    printf 'Fix: %s\n' "$2"
    exit 1
}

printf 'Running the full checks before pushing (same as CI)...\n'

printf '> Database is running\n'
php artisan app:wait-for-db --timeout=5 >"$log" 2>&1 \
    || fail "the database is not answering, and the tests need it." "start Docker Desktop, then composer db:up"

printf '> Build\n'
npm run build >"$log" 2>&1 \
    || fail "the front end build failed." "read the errors above, or run npm run build"

printf '> composer ci:check\n'
composer ci:check >"$log" 2>&1 \
    || fail "composer ci:check failed." "read the errors above. composer lint and npm run check:fix fix formatting."

printf 'All checks passed.\n'
exit 0
