{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(composer ci:check)",
      "Bash(composer test)",
      "Bash(composer lint)",
      "Bash(composer lint:check)",
      "Bash(composer types:check)",
      "Bash(composer run *)",
      "Bash(php artisan test)",
      "Bash(php artisan test *)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate:status)",
      "Bash(php artisan route:list *)",
      "Bash(php artisan app:doctor)",
      "Bash(php artisan metrics:refresh)",
      "Bash(npm run *)",
      "Bash(docker compose ps)",
      "Bash(docker compose up *)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch -c *)"
    ],
    "deny": [
      "Edit(./compose.yaml)",
      "Write(./compose.yaml)",
      "Edit(./docker/**)",
      "Write(./docker/**)",
      "Bash(docker compose down*)",
      "Bash(docker volume *)",
      "Bash(docker system prune*)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin staging*)",
      "Bash(git push origin HEAD:staging*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit * -n *)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --unset core.hooksPath*)"
    ]
  }
}
